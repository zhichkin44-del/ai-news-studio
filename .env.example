# Copy to .env and set values. The code reads these from the process environment;
# .env is not loaded automatically, so export the variables in your shell first.
# Leave a variable empty or remove it to use the default shown in README.md.

# SQLite database file (default: data/news.db)
NEWS_DB=data/news.db

# Folder for event packs written by `npm run batch` (default: data/batches)
NEWS_BATCHES=data/batches

# Folder for downloaded post images (default: data/images)
NEWS_IMAGES_DIR=data/images

# Full path to Chrome or Edge, used to render infographic cards.
# Get it from your installed browser, e.g. C:\Program Files\Google\Chrome\Application\chrome.exe
# Leave empty to auto-detect.
CARD_BROWSER=

# Number of events in an issue for `npm run issue` (default: 30)
ISSUE_N=30
